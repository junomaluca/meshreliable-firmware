{
  // ===== MeshReliable Default Configuration =====
  // These settings are applied on first boot or factory reset.
  // They ensure every MeshReliable device starts with the correct
  // network configuration without requiring manual setup.

  // ----- LoRa Radio -----
  "USERPREFS_CONFIG_LORA_REGION": "meshtastic_Config_LoRaConfig_RegionCode_US",
  "USERPREFS_LORACONFIG_MODEM_PRESET": "meshtastic_Config_LoRaConfig_ModemPreset_LONG_FAST",
  "USERPREFS_LORACONFIG_CHANNEL_NUM": "20",
  "USERPREFS_LORA_HOP_LIMIT": "7",
  "USERPREFS_LORA_OK_TO_MQTT": "true",
  // Transmit at maximum power allowed by hardware (20 dBm for SX1276)
  "USERPREFS_LORA_TX_POWER": "20",

  // ----- Channel 0: maluca (Primary) -----
  "USERPREFS_CHANNELS_TO_WRITE": "2",
  "USERPREFS_CHANNEL_0_NAME": "maluca",
  "USERPREFS_CHANNEL_0_PSK": "{ 0x42, 0x73, 0x30, 0x66, 0x76, 0x5a, 0x52, 0x52, 0x64, 0x42, 0x68, 0x67, 0x49, 0x38, 0x37, 0x64, 0x69, 0x67, 0x72, 0x48, 0x41, 0x63, 0x33, 0x32, 0x53, 0x71, 0x55, 0x39, 0x7a, 0x51, 0x72, 0x6e }",
  "USERPREFS_CHANNEL_0_PRECISION": "32",
  "USERPREFS_CHANNEL_0_UPLINK_ENABLED": "true",
  "USERPREFS_CHANNEL_0_DOWNLINK_ENABLED": "true",

  // ----- Channel 1: LongFast (Secondary) -----
  "USERPREFS_CHANNEL_1_NAME": "LongFast",
  "USERPREFS_CHANNEL_1_PSK": "{ 0x01 }",
  "USERPREFS_CHANNEL_1_PRECISION": "0",
  "USERPREFS_CHANNEL_1_UPLINK_ENABLED": "true",
  "USERPREFS_CHANNEL_1_DOWNLINK_ENABLED": "true",

  // ----- Bluetooth -----
  "USERPREFS_NO_PIN_BLUETOOTH": "1",

  // ----- Time Zone (US Pacific) -----
  "USERPREFS_TZ_STRING": "PST8PDT,M3.2.0/2:00:00,M11.1.0/2:00:00       ",

  // ----- Position -----
  "USERPREFS_CONFIG_POSITION_BROADCAST_INTERVAL": "3600",

  // ----- MQTT -----
  "USERPREFS_MQTT_ENABLED": "1",
  "USERPREFS_MQTT_ADDRESS": "'home.yazdikann.com:1883'",
  "USERPREFS_MQTT_USERNAME": "'admin'",
  "USERPREFS_MQTT_PASSWORD": "'admin'",
  "USERPREFS_MQTT_ROOT_TOPIC": "'msh/US'",
  "USERPREFS_MQTT_ENCRYPTION_ENABLED": "true",
  "USERPREFS_MQTT_TLS_ENABLED": "false",
  "USERPREFS_MQTT_CLIENT_PROXY": "false",
  "USERPREFS_MQTT_MAP_REPORTING_ENABLED": "true",
  "USERPREFS_MQTT_MAP_PUBLISH_INTERVAL": "3600",

  // ----- Store and Forward -----
  "USERPREFS_STORE_FORWARD_ENABLED": "true",
  "USERPREFS_STORE_FORWARD_HEARTBEAT": "true",
  "USERPREFS_STORE_FORWARD_RECORDS": "100",
  "USERPREFS_STORE_FORWARD_HISTORY_RETURN_MAX": "100",
  "USERPREFS_STORE_FORWARD_HISTORY_RETURN_WINDOW": "72000",

  // ----- External Notifications -----
  "USERPREFS_EXT_NOTIF_NAG_TIMEOUT": "1",
  "USERPREFS_EXT_NOTIF_ALERT_BELL": "true",

  // ----- Canned Messages -----
  "USERPREFS_CANNED_MESSAGES": "Are you ok?|I am ok|I am lost|I need help|I want to leave|Where are you?|Meet at the meeting point|I need to drink/eat|Yes|No|OK",

  // ----- Media Transfer -----
  "USERPREFS_MEDIA_TRANSFER_ENABLED": "true",
  "USERPREFS_MEDIA_TRANSFER_CHUNK_SIZE": "200",
  "USERPREFS_MEDIA_TRANSFER_YIELD_TO_TEXT": "true",
  "USERPREFS_MEDIA_TRANSFER_PREFER_24GHZ": "true",

  // ----- Ringtone -----
  "USERPREFS_RINGTONE_RTTTL": "24:d=32,o=5,b=565:f6,p,f6,4p,p,f6,p,f6,2p,p,b6,p,b6,p,b6,p,b6,p,b,p,b,p,b,p,b,p,b,p,b,p,b,p,b,1p.,2p.,p"
}
